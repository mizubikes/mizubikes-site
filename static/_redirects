# Old WordPress URL patterns -> Hugo equivalents (301)
# Specific rules first; Netlify uses the first match
/category/gravel-cx/*     /categories/gravel/        301
/category/bike-build/*    /categories/bike-builds/   301
/category/:cat/feed/      /categories/:cat/feed.xml  301
/category/:cat/page/*     /categories/:cat/          301
/category/*               /categories/:splat         301
/tag/*                    /tags/:splat               301
/author/*                 /about/                    301
/feed                     /feed.xml                  301
/feed/                    /feed.xml                  301
/comments/feed/           /feed.xml                  301
/page/*                   /                          301
/blog/*                   /posts/                    301
/wp-admin/*               /                          301
/wp-login.php             /                          301
/categories/reviews/*    /categories/road/          301
